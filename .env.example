# Copy to .env and fill in. .env is git-ignored. In Azure these come from Key Vault references.

# --- SQL Server (local Docker) ---
MSSQL_SA_PASSWORD=
DB_PASSWORD=
DB_MIGRATION_PASSWORD=
DB_MIGRATION_USERNAME=codehealth_owner

# --- Keycloak ---
KEYCLOAK_ADMIN_PASSWORD=
# demo (no login) or keycloak
SECURITY_MODE=demo
SPRING_PROFILES_ACTIVE=demo

# --- Generative AI ---
# template (no LLM) | spring-ai (set profile openai or ollama)
AI_PROVIDER=template
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_BASE_URL=https://api.openai.com

# --- Validation: static (patch must apply) | local (run tests N times) ---
VALIDATION_MODE=static

# --- CI ingest shared secret (required in keycloak mode) ---
CI_INGEST_TOKEN=

# --- Integrations (all optional; disabled = recorded as DRY_RUN) ---
GITHUB_ENABLED=false
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
JIRA_ENABLED=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=CH
SONAR_ENABLED=false
SONAR_URL=http://localhost:9000
SONAR_TOKEN=
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
EMAIL_ENABLED=false
EMAIL_TO=
MIDDLEWARE_ENABLED=false
MIDDLEWARE_URL=
MIDDLEWARE_API_KEY=
